# ==========================================
# NEXVANTA.AI — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Supabase (Database, Auth, RLS, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# 2. Razorpay (One-time Orders & Recurring Subscriptions)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# 3. Inngest (Background Jobs, Retries, Crons)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# 4. Resend (Transactional Emails)
RESEND_API_KEY=re_...
EMAIL_FROM=Nexvanta.AI <hello@nexvanta.ai>

# 5. Upstash Redis (Distributed Rate Limiting)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# 6. Credentials Vault (AES-256-GCM encryption key, 32-byte base64)
# Generate with: openssl rand -base64 32
CREDENTIAL_ENC_KEY=

# 7. LLM Providers (Anthropic / OpenAI)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# 8. Admin & Business Rules
ADMIN_EMAILS=hello.nexvanta56@gmail.com
PRICES_INCLUDE_GST=true
GST_PERCENT=18
GRACE_DAYS=3

# 9. Google Sheets CRM Webhook (Apps Script)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOOGLE_SHEET_SECRET=your_crm_secret

# 10. General & Tokens
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DOWNLOAD_TOKEN_SECRET=nx_dl_secret_key_prod_2026
